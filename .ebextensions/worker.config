packages:
  yum:
    supervisor: []

files:

  "/etc/supervisord.d/laravel-worker.ini":
    mode: "000644"
    owner: root
    group: root
    content: |
      [program:laravel-worker]
      process_name=%(program_name)s_%(process_num)02d
      command=php /var/app/current/artisan queue:work --sleep=3 --tries=3 --timeout=90
      autostart=true
      autorestart=true
      numprocs=1
      redirect_stderr=true
      stdout_logfile=/var/log/laravel-worker.log
      stopwaitsecs=3600

commands:
  restart_supervisor:
    command: systemctl restart supervisord